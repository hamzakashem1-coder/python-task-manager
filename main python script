# Self-test (python task_expense_manager.py --selftest)
# ----------------------------------------------------------------------------
def run_self_test():
    """Checks the important parts work on THIS computer. Returns True if all pass."""
    import tempfile
    results = []

    def check(name, condition):
        results.append(bool(condition))
        print("  [{}] {}".format("PASS" if condition else "FAIL", name))

    def raises(function, *args):
        try:
            function(*args)
        except ValueError:
            return True
        return False

    print("Python {} on {}".format(sys.version.split()[0], sys.platform))
    print("Data file would be: {}".format(default_data_path()))
    print("Running checks...")

    check("merge sort ascending", merge_sort([5, 2, 9, 1, 5, 6]) == [1, 2, 5, 5, 6, 9])
    check("merge sort descending", merge_sort([5, 2, 9, 1, 5, 6], reverse=True) == [9, 6, 5, 5, 2, 1])
    check("merge sort empty / single", merge_sort([]) == [] and merge_sort([3]) == [3])
    check("merge sort leaves original alone", (lambda a: (merge_sort(a), a)[1] == [3, 1, 2])([3, 1, 2]))

    sample = [Task(i, "t", "c", 1) for i in (1, 3, 4, 8, 10)]
    found = [binary_search_by_id(sample, i) for i in (1, 3, 10, 5, 0, 11)]
    check("binary search finds / misses correctly", found == [0, 1, 4, -1, -1, -1])
    check("binary search on empty list", binary_search_by_id([], 1) == -1)

    check("money '12.50' -> 1250p", parse_money("12.50") == 1250)
    check("money '£1,200.50' -> 120050p", parse_money("£1,200.50") == 120050)
    check("money rejects 0, negative, text, nan, 3dp, too big",
          all(raises(parse_money, bad) for bad in ("0", "-5", "abc", "nan", "1.234", "99999999999", "")))
    check("pence formatting", format_money(120050) == "£1,200.50" and format_money(5) == "£0.05")
    check("pence addition is exact (0.1 + 0.2)", parse_money("0.10") + parse_money("0.20") == 30)

    check("date '25/12/2026' accepted", parse_date("25/12/2026") == "2026-12-25")
    check("date rejects 31/02/2026, text, empty, year 1900",
          all(raises(parse_date, bad) for bad in ("31/02/2026", "abc", "", "01/01/1900")))

    check("search is case-insensitive",
          len(linear_search([Task(1, "Revise Paging", "Study", 1)], "paging")) == 1)

    with tempfile.TemporaryDirectory() as folder:
        path = os.path.join(folder, "test.json")
        store = DataStore(path)
        store.tasks.append(Task(store.new_id(), "Task A", "Study", 1, "2026-12-25"))
        store.expenses.append(Expense(store.new_id(), "Lunch", "Food", 1250, "2026-10-01"))
        store.tasks[0].mark_complete()
        check("save succeeds", store.save())
        again = DataStore(path)
        again.load()
        check("tasks survive save/load",
              len(again.tasks) == 1 and again.tasks[0].title == "Task A"
              and again.tasks[0].completed and again.tasks[0].due_date == "2026-12-25")
        check("expenses survive save/load",
              len(again.expenses) == 1 and again.expenses[0].amount_pence == 1250)
        check("next id preserved", again.next_id == 3)

        with open(path, "w", encoding="utf-8") as file:
            file.write("{ this is not valid json")
        broken = DataStore(path)
        message = broken.load()
        check("corrupt file is backed up and recovered",
              "damaged" in message and os.path.exists(path + ".corrupt") and broken.tasks == [])

    passed = sum(results)
    print("\n{} of {} checks passed.".format(passed, len(results)))
    print("ALL GOOD - the program is working." if passed == len(results)
          else "Some checks FAILED - please send me this output.")
    return passed == len(results)


# ----------------------------------------------------------------------------
# Entry point
# ----------------------------------------------------------------------------
def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print("Usage: python task_expense_manager.py [datafile.json | --selftest]")
        return
    if args and args[0] == "--selftest":
        sys.exit(0 if run_self_test() else 1)

    if hasattr(sys.stdout, "reconfigure"):          # lets '£' print on any terminal
        try:
            sys.stdout.reconfigure(errors="replace")
        except (OSError, ValueError, AttributeError):
            pass

    path = args[0] if args else default_data_path()
    app = App(DataStore(path))
    try:
        app.run()
    except (KeyboardInterrupt, EOFError):
        print("\n  Input closed - saving and exiting.")
        app.store.save()
    except Exception:                               # an unexpected bug: never lose data
        import traceback
        traceback.print_exc()
        app.store.save()
        print("\nAn unexpected error happened (details above). Your data was saved.")
        try:
            input("Press Enter to close...")        # keeps a double-clicked window open
        except (EOFError, KeyboardInterrupt):
            pass
        sys.exit(1)


if __name__ == "__main__":
    main()
