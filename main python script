import json
import os

DATA_FILE = "tasks.json"

def load_tasks():
    """Load tasks from local JSON file if it exists."""
    if not os.path.exists(DATA_FILE):
        return []
    try:
        with open(DATA_FILE, "r") as file:
            return json.load(file)
    except json.JSONDecodeError:
        return []

def save_tasks(tasks):
    """Save tasks to local JSON file."""
    with open(DATA_FILE, "w") as file:
        json.dump(tasks, file, indent=4)

def add_task(tasks):
    """Add a new task or expense item."""
    print("\n--- ADD NEW ENTRY ---")
    title = input("Enter task/expense title: ").strip()
    if not title:
        print("Error: Title cannot be empty.\n")
        return
    
    category = input("Enter category (e.g., Work, Tech, Expense): ").strip()
    if not category:
        category = "General"
        
    tasks.append({
        "title": title,
        "category": category,
        "status": "Pending"
    })
    save_tasks(tasks)
    print(f"✅ Success: '{title}' added under [{category}]!\n")

def view_tasks(tasks):
    """Display all recorded tasks and expenses."""
    if not tasks:
        print("\n📂 No tasks or expenses recorded yet.\n")
        return
    
    print("\n========================================")
    print("          CURRENT TASKS & EXPENSES        ")
    print("========================================")
    for i, t in enumerate(tasks, 1):
        status_icon = "✓" if t['status'] == "Completed" else "⏳"
        print(f"{i}. [{status_icon}] {t['title']} — [{t['category']}] ({t['status']})")
    print("========================================\n")

def complete_task(tasks):
    """Mark a task as completed."""
    view_tasks(tasks)
    if not tasks:
        return
    
    try:
        choice = int(input("Enter the number of the task to mark as complete: "))
        if 1 <= choice <= len(tasks):
            tasks[choice - 1]["status"] = "Completed"
            save_tasks(tasks)
            print(f"🎉 Task '{tasks[choice - 1]['title']}' marked as completed!\n")
        else:
            print("❌ Invalid task number.\n")
    except ValueError:
        print("❌ Please enter a valid number.\n")

def main():
    tasks = load_tasks()
    while True:
        print("========================================")
        print("     PYTHON CLI TASK & EXPENSE MANAGER  ")
        print("========================================")
        print("1. View Tasks & Expenses")
        print("2. Add New Entry")
        print("3. Mark Task as Complete")
        print("4. Exit")
        
        choice = input("Select an option (1-4): ").strip()
        
        if choice == "1":
            view_tasks(tasks)
        elif choice == "2":
            add_task(tasks)
        elif choice == "3":
            complete_task(tasks)
        elif choice == "4":
            print("\nExiting application. Have a great day!")
            break
        else:
            print("❌ Invalid choice. Please select between 1 and 4.\n")

if __name__ == "__main__":
    main()
